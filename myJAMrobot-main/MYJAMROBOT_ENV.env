# Obrigatórias
MYJAM_TELEGRAM_BOT_TOKEN=
MYJAM_BASE_URL=https://SEU-DOMINIO.railway.app
MYJAM_LASTFM_API_KEY=
MYJAM_OWNER_IDS=

# Persistência SQLite
MYJAM_DATABASE_URL=sqlite:////app/data/myjamrobot.sqlite3
MYJAM_DATA_DIR=/app/data

# Opcionais: metadados, capa e Canvas; nunca autenticam o usuário
MYJAM_SPOTIFY_CLIENT_ID=
MYJAM_SPOTIFY_CLIENT_SECRET=
MYJAM_CANVAS_CACHE_ENABLED=true
MYJAM_CANVAS_CACHE_CHANNEL_ID=0
MYJAM_COVER_CACHE_ENABLED=true
MYJAM_COVER_CACHE_CHANNEL_ID=0
MYJAM_CANVAS_AUDIO_PREVIEW_ENABLED=true

# Limites de segurança
MYJAM_COMMAND_RATE_LIMIT_ENABLED=true
MYJAM_COMMAND_RATE_LIMIT_WINDOW_SECONDS=60
MYJAM_COMMAND_RATE_LIMIT_STANDARD_PER_WINDOW=12
MYJAM_COMMAND_RATE_LIMIT_EXPENSIVE_PER_WINDOW=4
MYJAM_MAX_CONCURRENT_HEAVY_JOBS=3
MYJAM_MAX_LYRICS_BACKGROUND_TASKS=8
MYJAM_MAX_WEBHOOK_BYTES=1048576

# Proxies confiáveis para X-Forwarded-*; evite "*"
MYJAM_FORWARDED_ALLOW_IPS=127.0.0.1
